# Postgres configuration
POSTGRES_DB=change_from_local
POSTGRES_USER=change_from_local
POSTGRES_PASSWORD=change_from_local

# SQLAlchemy configuration
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/helpdesk
JWT_KEY=change_me

# Origin call API
CORS_ORIGIN=http://localhost:8080

# Change to False in production
DEBUG=True

# Flask key (cookies)
SECRET_KEY=to_change

# Port dev (main.py)
PORT=8080

# Mail configuration
# DEV : Mailpit (catch all, send nothing, display mails on http://localhost:8025)
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM=no-reply@flaskodoo.local

# PROD : ask mail provider
MAIL_USE_TLS=False
MAIL_USERNAME=
MAIL_PASSWORD=

# Reset password/email confirmation configuration (1h validity)
PASSWORD_RESET_MAX_AGE=3600
EMAIL_CONFIRMATION_MAX_AGE=86400